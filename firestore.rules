rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/savedWork/{itemId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read: if isOwner();

      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['value', 'deleted', 'updatedAt'])
        && request.resource.data.keys().hasAll(['deleted', 'updatedAt'])
        && request.resource.data.deleted is bool
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.deleted == true
            ? !('value' in request.resource.data)
            : request.resource.data.value is string
              && request.resource.data.value.size() <= 900000
        );

      // Deletes are represented by a private tombstone so sync can remove data
      // from other signed-in devices without granting permanent deletion access.
      allow delete: if false;
    }

    // Deny every other database path until a feature has specific rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
