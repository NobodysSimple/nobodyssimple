rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function own(uid){return signed() && request.auth.uid == uid;}
  function recent(){return signed() && request.time.toMillis() - request.auth.token.auth_time * 1000 < 300000;}
  function security(uid){return /databases/$(database)/documents/accountSecurity/$(uid);}
  function active(uid){return !exists(security(uid)) || get(security(uid)).data.get('deleting',false)==false;}
  function current(uid){return !exists(security(uid))||!('revokedAt' in get(security(uid)).data)||request.auth.token.auth_time*1000>get(security(uid)).data.revokedAt.toMillis();}
  function owner(uid){return own(uid)&&active(uid)&&current(uid);}
  function cleanup(uid){return own(uid)&&recent()&&current(uid)&&exists(security(uid))&&get(security(uid)).data.get('deleting',false)==true;}
  function unlocked(uid){return !exists(/databases/$(database)/documents/users/$(uid)/settings/account) || get(/databases/$(database)/documents/users/$(uid)/settings/account).data.get('sensitiveLock',false)==false || recent();}
  function moderator(){return signed() && owner(request.auth.uid) && exists(/databases/$(database)/documents/siteAdmins/$(request.auth.uid));}
  function knownKey(item){return item in ['ns-personal-maps-v1','ns-tool-favourites-v1','ns-tool-recent-v1','ns-account-learning-v2','ns-account-tool-drafts-v2','ns-account-mood-v2','ns-learn-quote-notes-v1','ns-reflection','ns-memory-jar-v1','nobodys-simple-full-profile-draft-v3','nobodys-simple-profile-state-checkins-v1','nobodys-simple-profile-feedback-v1','ns-navigation-context-v1','ns-navigation-projects-v1','ns-sensory-recipe-v1','ns-sensory-recipes-v3','nobodys-simple-sensory-recipes-v1','ns-social-battery-v3','ns-load-balancer-v2','ns-masking-contexts-v1','ns-masking-map-v2','ns-simplyfocus-recipe-v1','ns-simplyfocus-tasks-v1'];}
  function validWork(){let d=request.resource.data;return d.keys().hasOnly(['value','deleted','updatedAt','revision']) && d.keys().hasAll(['deleted','updatedAt','revision']) && d.deleted is bool && d.updatedAt==request.time && d.revision is int && (d.deleted ? !('value' in d) : d.value is string && d.value.size()<=800000);}
  match /users/{uid}/savedWork/{item}{
   allow read: if (owner(uid)&&unlocked(uid)) || cleanup(uid);
   allow create: if owner(uid)&&unlocked(uid)&&knownKey(item)&&validWork()&&request.resource.data.revision==1;
   allow update: if owner(uid)&&unlocked(uid)&&knownKey(item)&&validWork()&&request.resource.data.revision==resource.data.get('revision',0)+1;
   allow delete: if cleanup(uid);
  }
  function suitable(handle){
   let folded=handle.replace('0','o').replace('1','i').replace('3','e').replace('4','a').replace('5','s').replace('7','t').replace('8','b');
   let blocked='.*(nobodyssimple|nobodysimple|nobodysimpl|nobodyssimpie|admin|moderator|staff|official|support|firebase|system|fuck|shit|bitch|nigger|nigga|faggot|retard|whore|hitler).*';
   return !handle.matches(blocked)&&!folded.matches(blocked)&&!folded.replace('i','l').matches(blocked)&&!folded.matches('cunt.*')&&!(folded in ['cunt','fag','nazi']);
  }
  function validProfile(uid){
   let d=request.resource.data;
   return d.keys().hasOnly(['nickname','handle','avatarId','avatarData','bio','pronouns','visibility','createdAt','nicknameChangedAt','updatedAt'])
    && d.keys().hasAll(['nickname','handle','avatarId','avatarData','bio','pronouns','visibility','createdAt','nicknameChangedAt','updatedAt'])
    && d.nickname is string && d.nickname.matches('[A-Za-z0-9][A-Za-z0-9 _-]{2,23}')
    && d.handle == d.nickname.lower().replace('[ _-]','') && suitable(d.handle)
    && d.avatarId in ['base','affirmed','bowing','dancing','drawing','excited-wave','excited','frolicking','peering','thinking','reading','running','sitting','still','sulking','waiting','waltzing','yippie']
    && d.avatarData is string && d.avatarData.size()<=60000 && (d.avatarData=='' || d.avatarData.matches('data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+'))
    && d.bio is string && d.bio.size()<=280 && d.pronouns is string && d.pronouns.size()<=40
    && !(d.bio+d.pronouns).lower().matches('.*(https?:|www[.]|<|>).*')
    && d.visibility in ['private','public'] && d.updatedAt==request.time
    && getAfter(/databases/$(database)/documents/nicknames/$(d.handle)).data.uid==uid;
  }
  match /profiles/{uid}{
   allow get: if owner(uid)||cleanup(uid)||(resource.data.visibility=='public'&&active(uid));
   allow create: if owner(uid)&&validProfile(uid)&&request.resource.data.createdAt==request.time&&request.resource.data.nicknameChangedAt==request.time;
   allow update: if owner(uid)&&validProfile(uid)&&request.resource.data.createdAt==resource.data.createdAt
    && (request.resource.data.nickname==resource.data.nickname ? request.resource.data.nicknameChangedAt==resource.data.nicknameChangedAt : request.time>=resource.data.nicknameChangedAt+duration.value(14,'d')&&request.resource.data.nicknameChangedAt==request.time);
   allow delete: if cleanup(uid);
  }
  match /nicknames/{handle}{
   allow get: if signed();
   allow list: if own(resource.data.uid);
   allow create: if owner(request.resource.data.uid)&&request.resource.data.keys().hasOnly(['uid','createdAt'])&&request.resource.data.createdAt==request.time
    && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle==handle;
   allow update: if false;
   allow delete: if cleanup(resource.data.uid);
  }
  function validSettings(){
   let d=request.resource.data;
   return d.keys().hasOnly(['theme','language','textScale','contrast','motion','lowStim','sound','font','lineSpacing','simpleMode','tapControls','visualMode','saveDrafts','retentionDays','personalise','moodHistory','sensitiveLock','learningFormat','trackLearning','replyNotifications','siteUpdates','reminders','reminderTime','timeZone','mentions','profileVisibility','updatedAt'])
    && d.theme in ['system','light','dark'] && d.language in ['en','es','fr','de'] && d.textScale in [100,110,125,150] && d.contrast in ['standard','high'] && d.motion in ['system','reduce','full'] && d.font in ['system','readable'] && d.lineSpacing in [1.6,1.9,2.2] && d.visualMode in ['balanced','text','visual'] && d.learningFormat in ['any','reading','audio','video','interactive'] && d.profileVisibility in ['private','public']
    && d.lowStim is bool && d.sound is bool && d.simpleMode is bool && d.tapControls is bool && d.saveDrafts is bool && d.personalise is bool && d.moodHistory is bool && d.sensitiveLock is bool && d.trackLearning is bool && d.replyNotifications is bool && d.siteUpdates is bool && d.reminders is bool && d.mentions is bool
    && d.retentionDays==0 && d.reminders==false && d.replyNotifications==false && d.mentions==false
    && d.reminderTime is string && d.reminderTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]') && d.timeZone is string && d.timeZone.size()<=80 && d.updatedAt==request.time;
  }
  match /users/{uid}/settings/account{
   allow read: if owner(uid)||cleanup(uid);
   allow create: if owner(uid)&&validSettings();
   allow update: if owner(uid)&&validSettings()&&(!resource.data.sensitiveLock||request.resource.data.sensitiveLock||recent());
   allow delete: if cleanup(uid);
  }
  match /users/{uid}/settings/communityRate{
   allow read: if owner(uid)||cleanup(uid);
   allow create: if owner(uid)&&request.resource.data.keys().hasOnly(['lastCommentAt','lastCommentId'])&&request.resource.data.lastCommentAt==request.time&&getAfter(/databases/$(database)/documents/comments/$(request.resource.data.lastCommentId)).data.authorUid==uid;
   allow update: if owner(uid)&&request.resource.data.keys().hasOnly(['lastCommentAt','lastCommentId'])&&request.resource.data.lastCommentAt==request.time&&request.time>=resource.data.lastCommentAt+duration.value(20,'s')&&getAfter(/databases/$(database)/documents/comments/$(request.resource.data.lastCommentId)).data.authorUid==uid;
   allow delete: if cleanup(uid);
  }
  match /users/{uid}/devices/{id}{
   allow read: if owner(uid)||cleanup(uid);
   allow create: if owner(uid)&&request.resource.data.keys().hasOnly(['label','firstSeen','lastSeen'])&&request.resource.data.label is string&&request.resource.data.label.size()<=80&&request.resource.data.firstSeen==request.time&&request.resource.data.lastSeen==request.time;
   allow update: if owner(uid)&&request.resource.data.keys().hasOnly(['label','firstSeen','lastSeen'])&&request.resource.data.label is string&&request.resource.data.label.size()<=80&&request.resource.data.firstSeen==resource.data.firstSeen&&request.resource.data.lastSeen==request.time;
   allow delete: if cleanup(uid);
  }
  match /users/{uid}/blocks/{target}{
   allow read: if owner(uid)||cleanup(uid);
   allow create,update: if owner(uid)&&uid!=target&&request.resource.data.keys().hasOnly(['createdAt'])&&request.resource.data.createdAt==request.time;
   allow delete: if owner(uid)||cleanup(uid);
  }
  match /users/{uid}/notifications/{id}{allow read: if owner(uid)||cleanup(uid);allow delete: if cleanup(uid);}
  match /accountSecurity/{uid}{
   allow get: if own(uid);
   allow create: if own(uid)&&recent()&&request.resource.data.keys().hasOnly(['revokedAt','deleting','deleteRequestedAt'])&&((request.resource.data.keys().hasOnly(['revokedAt'])&&request.resource.data.revokedAt==request.time)||(request.resource.data.deleting==true&&request.resource.data.deleteRequestedAt==request.time));
   allow update: if own(uid)&&recent()&&current(uid)&&request.resource.data.keys().hasOnly(['revokedAt','deleting','deleteRequestedAt'])
    && (!resource.data.get('deleting',false)||request.resource.data.deleting==true)
    && ((!resource.data.get('deleting',false)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt'])&&request.resource.data.revokedAt==request.time)||(request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting','deleteRequestedAt'])&&request.resource.data.deleting==true&&request.resource.data.deleteRequestedAt==request.time));
   allow delete,list: if false;
  }
  match /siteAdmins/{uid}{allow get: if own(uid);allow write,list: if false;}
  function profile(uid){return get(/databases/$(database)/documents/profiles/$(uid)).data;}
  function canReply(d){return d.parentId=='' || (get(/databases/$(database)/documents/comments/$(d.parentId)).data.status=='approved'&&get(/databases/$(database)/documents/comments/$(d.parentId)).data.postId==d.postId&&!exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(get(/databases/$(database)/documents/comments/$(d.parentId)).data.authorUid))&&!exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/comments/$(d.parentId)).data.authorUid)/blocks/$(request.auth.uid)));}
  function validComment(id){
   let d=request.resource.data;let p=profile(request.auth.uid);let r=/databases/$(database)/documents/users/$(request.auth.uid)/settings/communityRate;
   return verified()&&d.keys().hasOnly(['postId','body','authorUid','nickname','handle','avatarId','avatarData','status','parentId','createdAt','updatedAt'])
    && d.authorUid==request.auth.uid&&d.status=='pending'&&d.postId is string&&d.postId.matches('[A-Za-z0-9_-]{1,150}')&&d.body is string&&d.body.size()>=2&&d.body.size()<=2000&&!d.body.lower().matches('(?s).*(https?://|www[.]).*')&&d.updatedAt==request.time
    && d.nickname==p.nickname&&d.handle==p.handle&&d.avatarId==p.avatarId&&d.avatarData==p.avatarData&&d.parentId is string&&canReply(d)
    && getAfter(r).data.lastCommentAt==request.time&&getAfter(r).data.lastCommentId==id&&(!exists(r)||request.time>=get(r).data.lastCommentAt+duration.value(20,'s'));
  }
  match /comments/{id}{
   allow get:if signed()&&owner(request.auth.uid)&&!exists(/databases/$(database)/documents/comments/$(id));
   allow read: if resource.data.status=='approved'||(signed()&&(owner(request.auth.uid)||cleanup(request.auth.uid))&&resource.data.authorUid==request.auth.uid)||moderator();
   allow create: if validComment(id)&&request.resource.data.createdAt==request.time;
   allow update: if (validComment(id)&&resource.data.authorUid==request.auth.uid&&resource.data.status!='deleted'&&request.time<resource.data.createdAt+duration.value(15,'m')&&request.resource.data.createdAt==resource.data.createdAt&&request.resource.data.postId==resource.data.postId&&request.resource.data.parentId==resource.data.parentId)
    || (signed()&&owner(request.auth.uid)&&resource.data.authorUid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','status','avatarData','updatedAt'])&&request.resource.data.body==''&&request.resource.data.status=='deleted'&&request.resource.data.avatarData==''&&request.resource.data.updatedAt==request.time)
    || (moderator()&&recent()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','moderatedAt','moderationReason'])&&request.resource.data.status in ['approved','rejected']&&request.resource.data.moderatedAt==request.time&&request.resource.data.moderationReason is string&&request.resource.data.moderationReason.size()<=300);
   allow delete: if cleanup(resource.data.authorUid);
  }
  match /reports/{id}{
   allow read: if moderator()||(signed()&&resource.data.reporterUid==request.auth.uid&&(owner(request.auth.uid)||cleanup(request.auth.uid)));
   allow create: if signed()&&owner(request.auth.uid)&&request.auth.token.email_verified==true&&request.resource.data.keys().hasOnly(['commentId','reporterUid','reason','status','createdAt'])&&request.resource.data.reporterUid==request.auth.uid&&id==request.resource.data.commentId+'_'+request.auth.uid&&get(/databases/$(database)/documents/comments/$(request.resource.data.commentId)).data.status=='approved'&&request.resource.data.reason is string&&request.resource.data.reason.size()>=3&&request.resource.data.reason.size()<=500&&request.resource.data.status=='open'&&request.resource.data.createdAt==request.time;
   allow update: if moderator()&&recent()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])&&request.resource.data.status=='resolved';
   allow delete: if cleanup(resource.data.reporterUid);
  }
  match /users/{uid}/{col}/{id}{allow read:if (owner(uid)||cleanup(uid))&&col in ['settings','devices','notifications','blocks'];allow delete:if cleanup(uid)&&col in ['settings','devices','notifications','blocks'];}
  // Public community content and verified-only participation.
  function verifiedIdentity(){return signed()&&owner(request.auth.uid)&&request.auth.token.email_verified==true;}
  function verified(){return verifiedIdentity()&&!exists(/databases/$(database)/documents/communityBans/$(request.auth.uid));}
  function boardMod(){return verified()&&moderator()&&recent();}
  function identityMatches(d){let p=profile(request.auth.uid);return d.authorUid==request.auth.uid&&d.nickname==p.nickname&&d.handle==p.handle&&d.avatarId==p.avatarId&&d.avatarData==p.avatarData;}
  function postPath(id){return /databases/$(database)/documents/boardPosts/$(id);}
  function livePost(id){return exists(postPath(id))&&get(postPath(id)).data.status=='published';}
  function parentCleanup(id){return signed()&&exists(postPath(id))&&cleanup(get(postPath(id)).data.authorUid);}
  function unblocked(a,b){return !exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))&&!exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));}
  function rated(kind,id,container,seconds){let r=/databases/$(database)/documents/users/$(request.auth.uid)/communityRates/$(kind);let d=getAfter(r).data;return d.at==request.time&&d.objectId==id&&d.containerId==container&&(!exists(r)||request.time>=get(r).data.at+duration.value(seconds,'s'));}
  match /users/{uid}/communityRates/{kind}{
   allow read: if owner(uid)||cleanup(uid);
   allow create,update: if verified()&&own(uid)&&request.resource.data.keys().hasOnly(['at','objectId','containerId'])&&request.resource.data.at==request.time&&request.resource.data.objectId is string&&request.resource.data.containerId is string&&(
    (kind=='post'&&rated(kind,request.resource.data.objectId,'',60)&&getAfter(/databases/$(database)/documents/boardPosts/$(request.resource.data.objectId)).data.authorUid==uid&&getAfter(/databases/$(database)/documents/boardPosts/$(request.resource.data.objectId)).data.createdAt==request.time)
    ||(kind=='reply'&&rated(kind,request.resource.data.objectId,request.resource.data.containerId,20)&&getAfter(/databases/$(database)/documents/boardPosts/$(request.resource.data.containerId)/replies/$(request.resource.data.objectId)).data.authorUid==uid&&getAfter(/databases/$(database)/documents/boardPosts/$(request.resource.data.containerId)/replies/$(request.resource.data.objectId)).data.createdAt==request.time)
    ||(kind=='message'&&rated(kind,request.resource.data.objectId,request.resource.data.containerId,3)&&getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.containerId)/messages/$(request.resource.data.objectId)).data.authorUid==uid&&getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.containerId)/messages/$(request.resource.data.objectId)).data.createdAt==request.time));
   allow delete: if cleanup(uid);
  }
  match /communityMembers/{uid}{
   allow get: if true;
   allow create,update: if verified()&&own(uid)&&request.resource.data.keys().hasOnly(['uid','nickname','handle','avatarId','avatarData','createdAt','updatedAt'])&&request.resource.data.uid==uid&&request.resource.data.nickname==profile(uid).nickname&&request.resource.data.handle==profile(uid).handle&&request.resource.data.avatarId==profile(uid).avatarId&&request.resource.data.avatarData==profile(uid).avatarData&&request.resource.data.updatedAt==request.time&&(resource==null?request.resource.data.createdAt==request.time:request.resource.data.createdAt==resource.data.createdAt);
   allow delete: if cleanup(uid);
  }
  function validBoardPost(){let d=request.resource.data;return d.keys().hasOnly(['title','body','status','authorUid','nickname','handle','avatarId','avatarData','attachmentCount','createdAt','updatedAt'])&&identityMatches(d)&&d.title is string&&d.title.size()>=3&&d.title.size()<=120&&d.body is string&&d.body.size()>0&&d.body.size()<=40000&&d.status=='published'&&d.attachmentCount is int&&d.attachmentCount>=0&&d.attachmentCount<=2&&d.updatedAt==request.time;}
  match /boardPosts/{id}{
   allow read: if resource.data.status=='published'||moderator()||(signed()&&resource.data.authorUid==request.auth.uid&&(owner(request.auth.uid)||cleanup(request.auth.uid)));
   allow create: if verified()&&validBoardPost()&&request.resource.data.createdAt==request.time&&rated('post',id,'',60)
    &&(request.resource.data.attachmentCount<1||existsAfter(/databases/$(database)/documents/boardPosts/$(id)/attachments/0))&&(request.resource.data.attachmentCount<2||existsAfter(/databases/$(database)/documents/boardPosts/$(id)/attachments/1));
   allow update: if verified()&&resource.data.status=='published'&&resource.data.authorUid==request.auth.uid&&request.resource.data.updatedAt==request.time&&(
     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','body','updatedAt'])&&request.resource.data.title is string&&request.resource.data.title.size()>=3&&request.resource.data.title.size()<=120&&request.resource.data.body is string&&request.resource.data.body.size()>0&&request.resource.data.body.size()<=40000)
     ||(request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','body','status','attachmentCount','updatedAt'])&&request.resource.data.title=='Removed post'&&request.resource.data.body==''&&request.resource.data.status=='deleted'&&request.resource.data.attachmentCount==0))
    ||(boardMod()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])&&request.resource.data.status=='hidden'&&request.resource.data.updatedAt==request.time);
   allow delete: if cleanup(resource.data.authorUid);
   match /attachments/{slot}{
    allow read: if livePost(id)||parentCleanup(id)||moderator()||(signed()&&owner(get(postPath(id)).data.authorUid));
    allow create: if verified()&&slot in ['0','1']&&getAfter(postPath(id)).data.authorUid==request.auth.uid&&getAfter(postPath(id)).data.createdAt==request.time&&getAfter(postPath(id)).data.attachmentCount>(slot=='0'?0:1)
     &&request.resource.data.keys().hasOnly(['name','mime','size','data'])&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.name.size()<=100&&request.resource.data.mime in ['image/png','image/jpeg','image/webp','application/pdf','text/plain']&&((request.resource.data.mime=='image/png'&&request.resource.data.name.matches('.+[.]png'))||(request.resource.data.mime=='image/jpeg'&&request.resource.data.name.matches('.+[.]jpg'))||(request.resource.data.mime=='image/webp'&&request.resource.data.name.matches('.+[.]webp'))||(request.resource.data.mime=='application/pdf'&&request.resource.data.name.matches('.+[.]pdf'))||(request.resource.data.mime=='text/plain'&&request.resource.data.name.matches('.+[.]txt')))&&request.resource.data.size is int&&request.resource.data.size>0&&request.resource.data.size<=122880&&request.resource.data.data is string&&request.resource.data.data.size()<=163840&&request.resource.data.data.matches('[A-Za-z0-9+/=]+');
    allow delete: if parentCleanup(id)||(verified()&&get(postPath(id)).data.authorUid==request.auth.uid&&getAfter(postPath(id)).data.status=='deleted');
   }
   match /replies/{replyId}{
    allow read: if (livePost(id)&&resource.data.status=='published')||moderator()||parentCleanup(id)||(signed()&&resource.data.authorUid==request.auth.uid&&(owner(request.auth.uid)||cleanup(request.auth.uid)));
    allow create: if verified()&&livePost(id)&&unblocked(request.auth.uid,get(postPath(id)).data.authorUid)&&identityMatches(request.resource.data)&&request.resource.data.keys().hasOnly(['authorUid','nickname','handle','avatarId','avatarData','body','status','createdAt','updatedAt'])&&request.resource.data.body is string&&request.resource.data.body.size()>0&&request.resource.data.body.size()<=12000&&request.resource.data.status=='published'&&request.resource.data.createdAt==request.time&&request.resource.data.updatedAt==request.time&&rated('reply',replyId,id,20);
    allow update: if (verified()&&resource.data.authorUid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','status','updatedAt'])&&request.resource.data.body==''&&request.resource.data.status=='deleted'&&request.resource.data.updatedAt==request.time)||(boardMod()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])&&request.resource.data.status=='hidden'&&request.resource.data.updatedAt==request.time);
    allow delete: if cleanup(resource.data.authorUid)||parentCleanup(id);
   }
   match /reactions/{uid}{
    allow read: if livePost(id)||parentCleanup(id);
    allow create,update: if verified()&&own(uid)&&livePost(id)&&unblocked(uid,get(postPath(id)).data.authorUid)&&request.resource.data.keys().hasOnly(['authorUid','kind','updatedAt'])&&request.resource.data.authorUid==uid&&request.resource.data.kind in ['like','care','relate','thoughtful','thanks','celebrate']&&request.resource.data.updatedAt==request.time;
    allow delete: if (verified()&&own(uid))||cleanup(resource.data.authorUid)||parentCleanup(id);
   }
  }
  function threadPath(id){return /databases/$(database)/documents/conversations/$(id);}
  function inThread(id){return signed()&&request.auth.uid in get(threadPath(id)).data.members;}
  function validThread(id){let d=request.resource.data;return id==d.members[0]+'~'+d.members[1]&& d.keys().hasOnly(['members','createdBy','createdAt','updatedAt','lastMessageId'])&&d.members is list&&d.members.size()==2&&d.members[0] is string&&d.members[1] is string&&d.members[0]!=d.members[1]&&request.auth.uid in d.members&&exists(/databases/$(database)/documents/profiles/$(d.members[0]))&&exists(/databases/$(database)/documents/profiles/$(d.members[1]))&&unblocked(d.members[0],d.members[1])&&d.updatedAt==request.time;}
  match /conversations/{id}{
   allow get: if verifiedIdentity()&&unlocked(request.auth.uid)&&(!exists(threadPath(id))||request.auth.uid in resource.data.members);
   allow list: if verifiedIdentity()&&unlocked(request.auth.uid)&&request.auth.uid in resource.data.members;
   allow create: if verified()&&unlocked(request.auth.uid)&&validThread(id)&&request.resource.data.createdBy==request.auth.uid&&request.resource.data.createdAt==request.time&&getAfter(/databases/$(database)/documents/conversations/$(id)/messages/$(request.resource.data.lastMessageId)).data.authorUid==request.auth.uid&&getAfter(/databases/$(database)/documents/conversations/$(id)/messages/$(request.resource.data.lastMessageId)).data.createdAt==request.time;
   allow update: if verified()&&unlocked(request.auth.uid)&&request.auth.uid in resource.data.members&&validThread(id)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessageId'])&&getAfter(/databases/$(database)/documents/conversations/$(id)/messages/$(request.resource.data.lastMessageId)).data.authorUid==request.auth.uid&&getAfter(/databases/$(database)/documents/conversations/$(id)/messages/$(request.resource.data.lastMessageId)).data.createdAt==request.time;
   match /messages/{messageId}{
    allow read: if verifiedIdentity()&&unlocked(request.auth.uid)&&(!exists(threadPath(id))||inThread(id));
    allow create: if verified()&&unlocked(request.auth.uid)&&request.auth.uid in getAfter(threadPath(id)).data.members&&unblocked(getAfter(threadPath(id)).data.members[0],getAfter(threadPath(id)).data.members[1])&&active(getAfter(threadPath(id)).data.members[0])&&active(getAfter(threadPath(id)).data.members[1])&&request.resource.data.keys().hasOnly(['authorUid','body','kind','flowerCount','createdAt'])&&request.resource.data.authorUid==request.auth.uid&&request.resource.data.createdAt==request.time&&request.resource.data.body is string&&((request.resource.data.kind=='text'&&request.resource.data.body.size()>0&&request.resource.data.body.size()<=12000&&request.resource.data.flowerCount==0)||(request.resource.data.kind=='flowers'&&request.resource.data.body==''&&request.resource.data.flowerCount is int&&request.resource.data.flowerCount>=1&&request.resource.data.flowerCount<=12))&&getAfter(threadPath(id)).data.lastMessageId==messageId&&getAfter(threadPath(id)).data.updatedAt==request.time&&rated('message',messageId,id,3);
    allow delete: if cleanup(resource.data.authorUid);
   }
  }
  function validBoardReport(id){let d=request.resource.data;return d.keys().hasOnly(['kind','postId','replyId','threadId','messageId','reporterUid','reportedUid','reason','quotedText','status','createdAt'])&&d.reporterUid==request.auth.uid&&d.reason is string&&d.reason.size()>=3&&d.reason.size()<=500&&d.status=='open'&&d.createdAt==request.time&&(
   (d.kind=='post'&&livePost(d.postId)&&d.quotedText==get(postPath(d.postId)).data.body&&d.reportedUid==get(postPath(d.postId)).data.authorUid&&id=='post~'+d.postId+'~'+request.auth.uid)
   ||(d.kind=='reply'&&livePost(d.postId)&&d.quotedText==get(/databases/$(database)/documents/boardPosts/$(d.postId)/replies/$(d.replyId)).data.body&&d.reportedUid==get(/databases/$(database)/documents/boardPosts/$(d.postId)/replies/$(d.replyId)).data.authorUid&&id=='reply~'+d.replyId+'~'+request.auth.uid)
   ||(d.kind=='message'&&inThread(d.threadId)&&d.quotedText==get(/databases/$(database)/documents/conversations/$(d.threadId)/messages/$(d.messageId)).data.body&&d.reportedUid==get(/databases/$(database)/documents/conversations/$(d.threadId)/messages/$(d.messageId)).data.authorUid&&id=='message~'+d.messageId+'~'+request.auth.uid));}
  match /boardReports/{id}{
   allow read: if moderator()||(signed()&&resource.data.reporterUid==request.auth.uid&&(owner(request.auth.uid)||cleanup(request.auth.uid)));
   allow create: if verified()&&validBoardReport(id);
   allow update: if boardMod()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])&&request.resource.data.status=='resolved';
   allow delete: if cleanup(resource.data.reporterUid);
  }
  match /communityBans/{uid}{allow get:if own(uid)||moderator();allow create,update:if boardMod()&&request.resource.data.keys().hasOnly(['createdAt','reason'])&&request.resource.data.createdAt==request.time&&request.resource.data.reason is string&&request.resource.data.reason.size()<=300;allow delete:if boardMod();}
  // Owner export and account deletion across nested public/private collections.
  match /{path=**}/replies/{id}{allow read:if signed()&&resource.data.authorUid==request.auth.uid&&(owner(request.auth.uid)||cleanup(request.auth.uid));}
  match /{path=**}/reactions/{id}{allow read:if signed()&&resource.data.authorUid==request.auth.uid&&(owner(request.auth.uid)||cleanup(request.auth.uid));}
  match /{path=**}/messages/{id}{allow read:if signed()&&resource.data.authorUid==request.auth.uid&&((verifiedIdentity()&&unlocked(request.auth.uid))||cleanup(request.auth.uid));}

  match /{document=**}{allow read,write:if false;}
 }
}
